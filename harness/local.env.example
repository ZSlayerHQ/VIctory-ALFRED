# This machine's harness paths. Copy to harness/local.env (git-ignored) and set the ones that differ from the
# defaults; leave a line out to keep its default. The environment always wins over this file.
# Paths only: any other name, VICTORY_ALLOW_OBS included, is ignored with a warning (harness/local-env.mjs).
# Forward slashes work everywhere; quote a value with spaces or not, either way.

# The title's executable inside the dump (the folder victory.toml's game_dir names).
GAME_EXE=X:/path/to/dump/game.exe

# Each run's capture folder is made as <VICTORY_CAPTURES>/<stamp>-<tag>. Outside every repo.
VICTORY_CAPTURES=X:/captures

# Snapshot builds (snapshot-build.sh), and the victory checkout --list reads commit subjects from.
VICTORY_BUILDS=X:/builds
VICTORY_REPO=X:/path/to/runtime

# The lane worktrees run-queue.sh looks a bare lane name up in.
VICTORY_WORKTREES=X:/path/to/worktrees

# PresentMon 2.6's executable, and RenderDoc's folder (presentmon.mjs, renderdoc.mjs). Without PRESENTMON_EXE,
# a run captures nothing (PresentMon runs by default when it is set) and the wrapper says "PresentMon: not configured".
PRESENTMON_EXE=X:/path/to/PresentMon-2.6.0-x64.exe
RENDERDOC_DIR=X:/path/to/renderdoc/RenderDoc

# The folder that holds NVIDIA's own Streamline and DLSS files (sl.interposer.dll and the rest), from NVIDIA's
# release. Only a run started with --menu-file whose menu asks for DLSS uses it; the runtime checks the files'
# signatures before it loads them. Leave it out and DLSS stays off.
STREAMLINE_DIR=X:/path/to/streamline

# Save snapshots (<root>/snapshots) and the backups taken before each --save restore (<root>/before-runs).
VICTORY_SAVE_BACKUPS=<home>/victory-save-backups
